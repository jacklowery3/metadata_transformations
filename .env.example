# Optional. If unset, mdt/catalog.py falls back to the lakehouse-explorer
# skill config (~/.claude/skills/lakehouse-explorer/.lakehouse_config.json).
# Values: Fivetran UI -> Destinations -> <MDLS destination> -> Catalog Integration.
POLARIS_CATALOG_URI=https://<host>.polaris.fivetran.com/api/catalog
POLARIS_TOKEN_URI=
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL
POLARIS_WAREHOUSE=
# Data bucket region (may differ from the Polaris host's region)
BUCKET_REGION=
